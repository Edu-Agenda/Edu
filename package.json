{
  "name": "eduagenda",
  "version": "1.0.0",
  "description": "Plataforma de registro academico para la region de Tumaco",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage --verbose",
    "test:watch": "jest --watch",
    "robot": "node robot.js",
    "robot:full": "node robot-full.js",
    "robot:ui": "node robot-full.js",
    "coverage": "jest --coverage --coverageReporters=lcov --coverageReporters=html --coverageReporters=text",
    "sonar": "npm run coverage && node sonar-scanner.js",
    "sonar:local": "npm run coverage && node sonar-scanner.js",
    "sonar:cloud": "npm run coverage && sonar-scanner -Dsonar.host.url=https://sonarcloud.io"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "puppeteer": "^24.43.1",
    "sonarqube-scanner": "^4.3.6",
    "supertest": "^6.3.4"
  }
}